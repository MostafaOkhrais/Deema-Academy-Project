---
import AppShell from '../layouts/AppShell.astro';
import Icon from '../components/Icon.astro';
---

<AppShell title="تسجيل الدخول">
  <h1 class="page-title">أهلاً بعودتك</h1>
  <p class="page-lead">سجّل دخولك لتتابع مساراتك وتسجيلاتك وشهاداتك.</p>

  <form class="sheet" id="li-form" novalidate>
    <div class="field">
      <label for="li-email">البريد الإلكتروني</label>
      <input id="li-email" name="email" type="email" autocomplete="email" required dir="ltr" placeholder="name@example.com" />
      <small class="error" data-error="email"></small>
    </div>
    <div class="field">
      <label for="li-password">كلمة المرور</label>
      <input id="li-password" name="password" type="password" autocomplete="current-password" required dir="ltr" />
      <small class="error" data-error="password"></small>
    </div>
    <p class="forgot"><a class="text-link" href="/reset">نسيت كلمة المرور؟</a></p>
    <p class="form-msg" id="li-msg" role="alert"></p>
    <div class="actions">
      <button class="btn" type="submit" id="li-submit">دخول <Icon name="arrow" /></button>
    </div>
  </form>

  <p class="switch">ما عندك حساب؟ <a class="text-link" href="/signup">أنشئ حسابك</a></p>
</AppShell>

<style>
  .forgot { margin-block-start: -0.5rem; }
  .switch { margin-block-start: 1.5rem; color: var(--fg-muted); }
</style>

<script>
  import '../scripts/login';
</script>
