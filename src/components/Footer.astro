---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
---

<footer class="surface footer" data-surface="deep">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo width={170} />
      <p>{site.tagline}</p>
    </div>

    <nav aria-label="روابط التذييل">
      <h2>الأكاديمية</h2>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div>
      <h2>تابعنا</h2>
      <p class="footer__handle" dir="ltr">{site.handle}</p>
      <p class="footer__handle" dir="ltr">{site.domain}</p>
    </div>
  </div>

  <div class="container footer__legal">
    <span dir="ltr">{site.nameEn} © {new Date().getFullYear()}</span>
    <span>جميع الحقوق محفوظة</span>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(48px, 7vw, 88px) 0; }
  .footer__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 2.5rem; }
  .footer__brand p { margin-block-start: 1.25rem; max-width: 30ch; color: var(--fg-muted); }
  .footer h2 { margin-block-end: 0.75rem; font-size: 1.25rem; color: var(--accent-ink); }
  .footer nav a { display: block; width: fit-content; padding-block: 0.2rem; text-decoration: none; color: var(--fg-muted); transition: color var(--dur); }
  .footer nav a:hover { color: var(--fg); }
  .footer__handle { color: var(--fg-muted); text-align: start; }
  .footer__legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    margin-block-start: 3rem; padding-block: 1.5rem; border-block-start: 1px solid var(--line);
    font-size: var(--fs-small); color: var(--fg-muted);
  }
  @media (max-width: 760px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
